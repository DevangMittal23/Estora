# Backend origin; /api/v1 is appended by the client.
VITE_API_URL=http://localhost:5000
# Public canonical origin. No trailing path, credentials or private information.
VITE_SITE_URL=https://estora-pi.vercel.app
# Optional Vercel server overrides (never bundled into the browser).
SEO_SITE_URL=https://estora-pi.vercel.app
SEO_API_URL=https://estora-api.onrender.com
# Optional public Razorpay test key (the server order key takes precedence).
VITE_RAZORPAY_KEY_ID=
