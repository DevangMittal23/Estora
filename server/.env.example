# HTTP port and environment
PORT=5000
NODE_ENV=development
# Atlas or a local replica set. Transactions require a replica set.
MONGO_URI=mongodb://127.0.0.1:27017/estora?replicaSet=rs0
# Generate a random secret of at least 32 characters; never commit real secrets.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN=1d
BCRYPT_ROUNDS=12
# Only this browser origin is allowed
CLIENT_URL=http://localhost:5173
# mock is permitted only outside production. razorpay uses test keys.
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# cloudinary in production; database stores dummy uploads locally for demo
MEDIA_MODE=database
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Password-reset email via Resend (demo logs links if this is unset)
EMAIL_FROM=noreply@estora.app
RESEND_API_KEY=
# Seed defaults; transaction-time calculations read Settings from MongoDB
PLATFORM_FEE_PCT=2
BROKER_COMMISSION_PCT=1
MAX_OWNERSHIP_PCT=49
# Required ONLY when intentionally replacing the configured database with demo data
ALLOW_SEED_RESET=false
# Test binary cache kept inside the repository
MONGOMS_DOWNLOAD_DIR=.local/mongodb-binaries
